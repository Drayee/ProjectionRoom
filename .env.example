# 本机开发实例的环境文件（非 docker 的 PostgreSQL 18）。
#
# ⚠ 这个文件**不进版本库**（.gitignore 的 `.env*` 规则），因为它含凭据。
# 形态与生产一致（生产那份在 /opt/projectionroom/.env，root:600）。
#
# 用法：
#   powershell -File scripts/run-local.ps1
# 或手动：
#   $env:PR_DB_DSN='...'; go run ./cmd

# 监听地址。8888 是本项目的默认值；换端口时 PR_ALLOWED_ORIGINS 也要跟着加。
PR_ADDR=127.0.0.1:8888

# —— 必需配置（缺任何一项都会在启动期被拒绝，并逐条列出缺什么）——

# PostgreSQL 连接串。本机 PG18（非 docker），库与角色由 scripts/setup-local-db.ps1 创建。
PR_DB_DSN=host=127.0.0.1 port=5432 user=pr_app password=__FILL_ME__ dbname=projectionroom sslmode=disable TimeZone=Asia/Shanghai

# access token 的 HS256 密钥，**至少 32 字节**（openssl rand -hex 32）。
PR_JWT_SECRET=__FILL_ME__

# 邮件里链接的对外基地址（**没有默认值**：漏配会静默指向另一个环境）。
PR_PUBLIC_BASE_URL=http://127.0.0.1:8888

# 发信通道：注册与改密码都靠邮箱验证码。
# 本机没有 SMTP 时，保留下面三个为空并打开 PR_OTP_DEV_ECHO=1（验证码回显在响应里）。
PR_SMTP_HOST=
PR_SMTP_USER=
PR_SMTP_PASS=
# ⚠ 仅本机开发：1 = 验证码明文回显。与已配 SMTP 同时开启会**拒绝启动**。
PR_OTP_DEV_ECHO=1

# 验证码有效期（默认 5m，允许 1m~30m）。
# PR_OTP_TTL=5m

# 跳过"必需配置齐全"这道启动闸（默认开启校验）。
# 只有刻意要功能不全的实例（例如只跑信令）时才写 0。
# PR_REQUIRE_COMPLETE=0

# WebSocket 来源白名单。默认值已含 127.0.0.1:8888 与 5173；
# 换端口（如 8090）或走域名/隧道时，**必须**把那个来源加进来，否则 /ws 一律 403。
# 例：PR_ALLOWED_ORIGINS=127.0.0.1:8090,127.0.0.1:5173
#
# —— 生产（80 单端口）配法 ——
# 生产走 nginx 80 反代时，浏览器的 Origin 是 `http://<域名或IP>`，
# **不带端口**（80 是 http 默认端口，浏览器不写进 Origin）。所以：
#   PR_ALLOWED_ORIGINS=http://60.205.212.25,http://60.205.212.25:80
# 两种形态都写上是因为：手写 URL 带 :80 时 Origin 会带端口，
# 而地址栏输入域名时浏览器会省略它。漏掉任一种都会让一部分用户 /ws 403。
