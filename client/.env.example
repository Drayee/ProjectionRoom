# 前端（client/）的开发期环境变量模板。
#
# 用法：复制成 `client/.env.local`（已被 `.gitignore` 的 `.env*` 规则忽略）后按需改。
# 这些变量全部是 **Vite 构建期常量**：改完必须重启 `npm run dev` 或重新 `npm run build`，
# 热更新不会重读 `.env`。
#
# ⚠ 本文件的键名是契约：`client/src/api/mode.ts` 逐个静态读取它们
# （`import.meta.env.VITE_MOCK_POSTS` 这种写法 Vite 才能替换）。改名 = 开关静默失效。
#
# ---------------------------------------------------------------------------
# mock / real 适配层开关（wayfinder #22）
# ---------------------------------------------------------------------------
#
# 六个分区的后端接口按域分批上线，所以每个域一个开关。语义是**默认 mock**：
# 只有显式写成 `0` / `false` / `off` / `no` 才翻成真实实现；留空、不写、写成别的值
# 一律按 mock 处理（配错退化成"还是 mock"，不会退化成整片分区 404）。
#
# 翻成真实实现后，若该域的后端路由还没注册（服务端返回 404），页面渲染
# 「该分区后端尚未上线」空态（components/ui/CapabilityNotice.vue），不是裸错误。
# 这就是"前端先行、后端跟进"的切换点：后端票落地时只改这里一行。
#
# 各域对应的后端票：#27 posts / #29 friendships / #31 messages / #37+#38 forum
# / #35 official / #33 users。

# 帖子（/posts ×3）：默认 mock，数据在 api/mock/posts.ts
VITE_MOCK_POSTS=1

# 好友（/friends）：后端 #29（6 端点）+ #39（找人 / 黑名单列表 / 解除拉黑）均已落地
VITE_MOCK_FRIENDS=1

# 消息（/messages）：后端 #31（messages 表 + 4 个端点 + `/me` 的 unread）已落地
VITE_MOCK_MESSAGES=1

# 番剧论坛（/forum）：依赖 anime 目录 + 主题串接口。
# ⚠ 主题串详情与回复走**帖子域**（`/posts/:id` 与评论），所以 mock 态下本开关与
# `VITE_MOCK_POSTS` 必须同为 mock 才连得通（两边共用 api/mock/animeSeed.ts 的 id）；
# 翻真时两个域一起翻，否则板块里的假 id 会被真后端判成「内容不存在」。
VITE_MOCK_FORUM=1

# 官方分区（/official）：依赖房间的官方/推荐标记
VITE_MOCK_OFFICIAL=1

# 用户公开档案（/user/:id 他人视角）：依赖 GET /api/users/:id
VITE_MOCK_USERS=1

# ---------------------------------------------------------------------------
# 调试钩子（安全批次 F-5，与适配层无关，一并记在这里）
# ---------------------------------------------------------------------------
#
# `1` = 把 `window.__pr` 调试快照编进产物。**生产构建绝不能开**：
# `npm run build` 后 grep 产物必须 0 命中 `window.__pr`。
# 只有 `test/script/verify-*.mjs` 这类真机验收脚本需要它。
# VITE_DEBUG_HOOKS=1
